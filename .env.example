# Copy this file to .env and replace every change-me value.
DATA_PILOT_MYSQL_HOST=127.0.0.1
DATA_PILOT_MYSQL_PORT=3307
DATA_PILOT_MYSQL_ROOT_PASSWORD=change-me
DATA_PILOT_MANAGEMENT_DB_USERNAME=data_pilot_app
DATA_PILOT_MANAGEMENT_DB_PASSWORD=change-me
DATA_PILOT_BUSINESS_DB_USERNAME=ecommerce_reader
DATA_PILOT_BUSINESS_DB_PASSWORD=change-me
DATA_PILOT_REDIS_HOST=127.0.0.1
DATA_PILOT_REDIS_PORT=6379
DATA_PILOT_REDIS_PASSWORD=change-me
DATA_PILOT_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key

# Async query results are isolated by task ID and expire automatically.
DATA_PILOT_ASYNC_CORE_POOL_SIZE=2
DATA_PILOT_ASYNC_MAX_POOL_SIZE=4
DATA_PILOT_ASYNC_QUEUE_CAPACITY=50
DATA_PILOT_ASYNC_RESULT_TTL=15m
DATA_PILOT_ASYNC_SSE_TIMEOUT=5m

# AI is optional. Keep disabled until an OpenAI-compatible endpoint is configured.
DATA_PILOT_AI_ENABLED=false
DATA_PILOT_AI_PROVIDER=none
DATA_PILOT_AI_BASE_URL=https://api.openai.com
DATA_PILOT_AI_API_KEY=change-me
DATA_PILOT_AI_MODEL=gpt-4.1-mini

# Schema RAG uses local Ollama for embeddings and a dedicated PostgreSQL database.
DATA_PILOT_RAG_ENABLED=true
DATA_PILOT_RAG_MODE=AUTO
DATA_PILOT_EMBEDDING_PROVIDER=ollama
DATA_PILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
DATA_PILOT_OLLAMA_EMBEDDING_MODEL=bge-m3
DATA_PILOT_POSTGRES_HOST=127.0.0.1
DATA_PILOT_POSTGRES_PORT=5432
DATA_PILOT_POSTGRES_ADMIN_USERNAME=postgres
DATA_PILOT_POSTGRES_ADMIN_PASSWORD=change-me
DATA_PILOT_VECTOR_DB_NAME=data_pilot_vector
DATA_PILOT_VECTOR_DB_USERNAME=data_pilot_vector_app
DATA_PILOT_VECTOR_DB_PASSWORD=change-me
